# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: Transaction/session pooler connection (or direct URL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# DIRECT_URL: Direct PostgreSQL connection used by Prisma CLI for migrations (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# MongoDB Atlas Configuration (Audit & Activity Logging)
MONGODB_URI="mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/stockroom?retryWrites=true&w=majority"
